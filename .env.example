# ─── SkinProof configuration ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Public URL of the app (used for absolute links). Local: http://localhost:3000
APP_URL=http://localhost:3000

# ── Database ──
# Leave EMPTY to use the embedded PGlite database at ./.data/pglite (zero setup).
# Or point at any Postgres 14+: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ── YouCam API (https://yce.makeupar.com/api-console/en/api-keys/) ──
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# true = deterministic fake results, spends 0 units (auto-on when YOUCAM_API_KEY is empty)
YOUCAM_MOCK=true
# auto = HD when the photo's short side >= 1080px, else SD.  sd | hd to force.
YOUCAM_MODE=auto
# Units you have available (hackathon grant = 1000). Used for the in-app budget meter.
YOUCAM_UNIT_BUDGET=1000
# Public-deployment guards (0 = unlimited): live scans and AI requests per user per 24 hours
SCANS_PER_USER_PER_DAY=10
AI_CALLS_PER_USER_PER_DAY=60

# ── AI (free tiers) — set ONE key. Used for label photos, product links and the coach. ──
# Groq:   https://console.groq.com/keys          (default models: openai/gpt-oss-120b, vision qwen/qwen3.8-27b)
# Gemini: https://aistudio.google.com/apikey     (default model: gemini-3.6-flash, falls back to 3.5 / 2.5 Flash)
# auto = Groq if GROQ_API_KEY is set, else Gemini.  groq | gemini to force one.
LLM_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides of the provider defaults above (leave empty to use them)
LLM_MODEL=
LLM_VISION_MODEL=

# ── Developer ──
# true = show "skip ahead +1 / +7 / +14 days" on the Trials page. It moves YOUR account's records into the past
# so the next real scan counts as later. Never affects the shared demo account. Keep false in production.
DEV_TIME_TRAVEL=false
